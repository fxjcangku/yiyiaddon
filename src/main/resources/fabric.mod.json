{
  "schemaVersion": 1,
  "id": "yiyiaddon",
  "version": "${version}",
  "name": "yiyiaddon",
  "description": "Standalone Fabric client addon for Minecraft 26.2.",
  "authors": [
    "yiyiaddon"
  ],
  "license": "See LICENSE",
  "icon": "assets/yiyiaddon/icon.png",
  "environment": "client",
  "entrypoints": {
    "main": [
      "com.yiyiaddon.YiyiAddon"
    ],
    "client": [
      "com.yiyiaddon.YiyiAddonClient"
    ]
  },
  "mixins": [
    "yiyiaddon.mixins.json",
    "yiyiaddon.baritone.mixins.json"
  ],
  "accessWidener": "yiyiaddon.accesswidener",
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": "${minecraft_compat}",
    "java": ">=${jdk_version}",
    "fabric-api": "*"
  }
}
